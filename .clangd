CompileFlags:
  Remove:
    - "-mcpu=*"
    - "-flto*"
    - "-Ofast"
    - "-fomit-frame-pointer"

Diagnostics:
  Suppress:
    - "-Wunused-*"
  Includes:
    # umbrella header (wraps SDL/SDL2 per-platform); include-cleaner would
    # otherwise flag every consumer with "sdl.h is not used directly"
    IgnoreHeader: [sdl\.h]

---

If:
  PathMatch: .*\.(cpp|cxx|cc|hpp|hxx)

CompileFlags:
  Add:
    - "-std=c++17"

---

# Vendored/patched ffplay: only compiles inside an ffmpeg 6.1 build tree
# (see build.sh next to it) — config.h/config_components.h are generated by
# ffmpeg's configure and the AV* headers aren't on the host, so every
# diagnostic here is noise.
If:
  PathMatch: .*/mediaplayer/include/ffplay/.*

CompileFlags:
  # no error cap: the "too many errors" fatal is not suppressible by name
  Add: ["-ferror-limit=0"]

Diagnostics:
  Suppress: "*"
